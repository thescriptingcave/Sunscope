# Copy to .env and fill in. NEVER commit .env.
# Generate real values with: ./scripts/gen-secrets.sh

# ---------- InfluxDB 3 Core ----------
# Admin token, generated by scripts/gen-secrets.sh and mounted into the server
# as an offline token file. Used only by the init service.
INFLUX_ADMIN_TOKEN=change-me-admin-token
# The tokens below are created by the influx-init service on first `up` and
# written back into .env. Leave them empty here.
#
# NOTE: InfluxDB 3 Core 3.11 does NOT support permission-scoped database
# tokens -- `influxdb3 create token` only offers --admin. Every token created
# here is an admin token. Separate named tokens still give per-component
# attribution and independent revocation. See docs/04-security.md.
INFLUX_WRITE_TOKEN=
INFLUX_READ_TOKEN=
INFLUX_API_TOKEN=
INFLUX_DB=solar
INFLUX_URL=https://localhost:8181  # TLS is required; see scripts/gen-tls-cert.sh

# ---------- MQTT / EMQX ----------
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
# MQTT over WebSocket — the endpoint the PWA connects to.
MQTT_WS_PORT=8083
MQTT_WS_PATH=/mqtt
MQTT_EMQX_DASHBOARD_PORT=18083
EMQX_DASHBOARD_USERNAME=admin
EMQX_DASHBOARD_PASSWORD=change-me
# Site name used as the MQTT topic root and the InfluxDB `site` tag.
SITE_NAME=mojave

# ---------- Grafana ----------
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me
# Grafana 12.2+ requires this toggle for the InfluxDB SQL query editor.
GRAFANA_FEATURE_TOGGLES=newInfluxDSConfigPageDesign

# ---------- FastAPI ----------
API_PORT=8000
API_SECRET_KEY=change-me-long-random-string
# Single-user login for the PWA.
API_ADMIN_USERNAME=admin
API_ADMIN_PASSWORD=change-me
# Comma-separated list of allowed CORS origins.
API_CORS_ORIGINS=http://localhost:5173,http://localhost:8000

# ---------- Web Push (VAPID) ----------
# Generate with: ./scripts/gen-secrets.sh
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@example.com

# ---------- Simulator ----------
SIM_INTERVAL_SECONDS=30
# Time acceleration. 1 = real time, 60 = 1 day in 24 min, 3600 = 1 day in 24 s.
SIM_SPEED=1
# Emit deliberately broken payloads to exercise alert paths. Never in production.
SIM_INJECT_FAULTS=false
