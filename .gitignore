# --- Secrets (never commit) ---
.env
secrets/
*.pem
*.key

# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# --- Node ---
node_modules/
dist/
.vite/
*.tsbuildinfo
npm-debug.log*

# --- Data / runtime ---
data/
*.db
*.parquet
influxdb.bolt
influxdb.v1
logs/
*.log
# Written by scripts/bootstrap.sh when it starts the simulator on the host.
.sim.pid
# Screenshots from scripts/browser/check-ui.js; regenerate rather than commit.
shots/
# Database backups from scripts/backup.py. Real data, not source.
backups/
# The API user store: PBKDF2 digests of real passwords, written by
# scripts/gen-secrets.sh. A digest is not a plaintext secret, but it is offline-crackable
# material -- publishing one for a password anyone can guess turns the account into a
# published credential. Commit api/config/users.yaml.example instead, which documents the
# format with digests that cannot verify against anything.
api/config/users.yaml

# --- Editors / OS ---
.DS_Store
.idea/
.vscode/
*.swp
