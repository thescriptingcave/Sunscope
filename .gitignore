# --- Secrets (never commit) ---
.env
secrets/
*.pem
*.key

# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# --- Node ---
node_modules/
dist/
.vite/
